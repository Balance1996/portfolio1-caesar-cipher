shift_input=int(input("Enter the shift input in numerical values:\n"))
new_shift=shift_input%26
def hacking_cipher(txt,shift_amt, mode):
    end_text=""
    if mode=='decode':
        shift_amt*=-1
    for char in txt:
        if char in alphabet:
            pos=alphabet.index(char)
            new_pos=(shift_amt+pos)%26
            end_text+=alphabet[new_pos]
        else:
            end_text+=char
    return end_text
